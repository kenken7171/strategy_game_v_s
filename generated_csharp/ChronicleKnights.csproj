<Project Sdk="Godot.NET.Sdk/4.3.0">

  <!-- ===========================================================================
       Chronicle Knights — 本体プロジェクト (Godot 4 / .NET 8 / C# 12)
       ===========================================================================
       Godot.NET.Sdk を採用したゲーム本体のビルド定義。SDK の既定取り込みにより
       本 csproj が置かれたディレクトリ (generated_csharp/) 以下の全 *.cs を
       コンパイル対象とする。したがって以下が自動で本体へ含まれる:

         Core/      … Godot 非依存の純粋ゲームロジック（脳）
         Autoload/  … ChronicleGlobal（常駐シングルトン / SoT）
         UI/        … 各フェーズ画面とメイン制御ディレクター（身体）

       ★ 除外方針:
         Tests/ は xUnit 専用の別アセンブリ（Tests/ChronicleKnights.Tests.csproj が
         ../Core を独自にコンパイル取り込みする）。本体ビルドへ二重取り込みしない
         よう Tests/ 配下を明示的に Compile から除外する。
         .godot/ は Godot が生成するインポートキャッシュ。万一 .cs が紛れても
         本体へ取り込まないよう除外しておく（安全網）。
       ========================================================================== -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- ===========================================================================
         ローカル実行の前方互換（RollForward）
         ===========================================================================
         本体は net8.0 をターゲットにビルドするが、ホストに net8 ランタイムが無く
         より新しい .NET ランタイムしか入っていない場合（例: 旅団長 Mac は net10 のみ）
         でも起動できるよう、フレームワーク解決を「最新メジャーへ前方巻き上げ」に固定する。
         net8 ランタイムが在ればそれを最優先し、無ければ導入済みの最新メジャー（net9/net10…）へ
         ロールフォワードする。これにより Godot エディタの実行ボタン・コマンドライン双方で、
         環境変数や追加インストール無しに起動可能となる（既定の LatestMinor では net8 系内に
         閉じてしまい net10 へ届かないため、明示的に LatestMajor へ昇格する）。 -->
    <RollForward>LatestMajor</RollForward>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChronicleKnights</RootNamespace>
    <AssemblyName>ChronicleKnights</AssemblyName>

    <!-- ===========================================================================
         警告ゼロの防壁（Warnings-as-Errors の限定適用）
         ===========================================================================
         実機コンパイル適応の静的全件監査（2026-06-11）で「我々の手書きソースには
         一件も存在しない」と直接確認できた CS 警告コードだけを、ビルドエラーへ昇格
         させて恒久的に封じる。これにより将来このコードベースへ該当警告が再混入した
         瞬間にビルドが赤化し、混入を物理的に拒絶する（回帰の防壁）。

         ★ 限定適用の理由（blanket TreatWarningsAsErrors を採らない理由）:
           Godot.NET.Sdk のソースジェネレータが生成する partial コードや、将来の SDK
           更新が吐きうる未知の警告まで一括でエラー化すると、実機の初回ビルドを
           かえって不安定化させる。よって「監査で実在しないと確証した CS コード」に
           限って昇格し、未検証領域は通常の警告のまま残す（安定化を最優先）。

         昇格コードと監査根拠:
           CS1998 / CS4014  非同期警告      — async/await はコード全域にゼロ（構造的に発生不能）
           CS8618           非Null未初期化  — 全フィールドが ? 付き、record は既定値/required
           CS8602/03/04     Null フロー      — 全 deref を is null / ?. / ?? / is not null で防御
           CS8509 / CS8524  switch 網羅      — 全 enum/判別共用体の switch 式に _ => 受け皿あり
           CS0162           到達不能         — break を一切使わず全 case が return、default も到達可
           CS0169/0414/0649 死蔵フィールド   — 宣言のみ（参照1回）のフィールドはゼロ
           CS0067           未使用イベント   — 宣言した event は全て ?.Invoke 済み
         ========================================================================== -->
    <WarningsAsErrors>CS1998;CS4014;CS8618;CS8602;CS8603;CS8604;CS8509;CS8524;CS0162;CS0169;CS0414;CS0649;CS0067</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove=".godot/**/*.cs" />
  </ItemGroup>

</Project>
