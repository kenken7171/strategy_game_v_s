<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===========================================================================
       ChronicleKnights — テストプロジェクト (xUnit)
       ===========================================================================
       本番コードとは完全に分離した、Godot 非依存のコアロジック層だけを対象に
       する単体テストプロジェクト。Godot ランタイム・GodotSharp への参照を一切
       持たないため、`dotnet test` だけで純粋にビルド・実行できる。

       ★ ソース取り込み方針:
         本番コア層 (../Core) のソースを直接コンパイル取り込みする。ただし
         Godot.FileAccess / Godot.DirAccess に依存する SaveManager.cs だけは
         除外する（Godot 非依存の SaveSerializer.cs はテスト対象に含める）。

         Autoload/ChronicleGlobal.cs (Godot.Node 継承) や UI/*.cs は
         ../Core の外なので、そもそも取り込まれない（テスト対象外）。
       ========================================================================== -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ChronicleKnights.Tests</RootNamespace>

    <!-- ===========================================================================
         警告ゼロの防壁（Warnings-as-Errors の限定適用）
         ===========================================================================
         本テストアセンブリは ../Core/**/*.cs（SaveManager.cs を除く純粋ロジック層）を
         直接取り込んでコンパイルする。静的全件監査（2026-06-11）で取り込み対象の Core
         および本テストコードに「実在しない」と直接確認できた CS 警告コードのみを
         エラー化し、純粋ロジック層を `dotnet test` 実行時のハードゲートとして封印する。

         ★ xUnit アナライザ（xUnit1xxx/2xxx）は本リストに含めない:
           解析器を実走させない限り検証不能なため、blanket 化で初回 `dotnet test` を
           破壊しないよう、監査で確証した CS コードだけに限定昇格する（本体 csproj と同方針）。
         ========================================================================== -->
    <WarningsAsErrors>CS1998;CS4014;CS8618;CS8602;CS8603;CS8604;CS8509;CS8524;CS0162;CS0169;CS0414;CS0649;CS0067</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 本番コア層 (Godot 非依存) のソースをコンパイル取り込み。
       Godot に依存する SaveManager.cs のみ除外する。 -->
  <ItemGroup>
    <Compile Include="../Core/**/*.cs" Exclude="../Core/Persistence/SaveManager.cs" />
  </ItemGroup>

</Project>
