<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===========================================================================
       ChronicleKnights — テストプロジェクト (xUnit)
       ---------------------------------------------------------------------------
       本番コードとは完全に分離した、Godot 非依存のコアロジック層だけを対象に
       する単体テストプロジェクト。Godot ランタイム・GodotSharp への参照を一切
       持たないため、`dotnet test` だけで純粋にビルド・実行できる。

       ★ ソース取り込み方針:
         本番コア層 (../Core) のソースを直接コンパイル取り込みする。ただし
         Godot.FileAccess / Godot.DirAccess に依存する SaveManager.cs だけは
         除外する（Godot 非依存の SaveSerializer.cs はテスト対象に含める）。

         Autoload/ChronicleGlobal.cs (Godot.Node 継承) や UI/*.cs は
         ../Core の外なので、そもそも取り込まれない（テスト対象外）。
       ========================================================================== -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ChronicleKnights.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 本番コア層 (Godot 非依存) のソースをコンパイル取り込み。
       Godot に依存する SaveManager.cs のみ除外する。 -->
  <ItemGroup>
    <Compile Include="../Core/**/*.cs" Exclude="../Core/Persistence/SaveManager.cs" />
  </ItemGroup>

</Project>
