{
  "name": "Chronicle Knights (.NET 8 + Godot 4.3 mono)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "DOTNET_SDK_TAG": "8.0",
      "GODOT_VERSION": "4.3",
      "GODOT_RELEASE": "stable"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "geequlim.godot-tools"
      ],
      "settings": {
        "dotnet.defaultSolution": "generated_csharp/ChronicleKnights.csproj",
        "godotTools.editorPath.godot4": "/usr/local/bin/godot"
      }
    }
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "postCreateCommand": "dotnet restore generated_csharp/ChronicleKnights.csproj && dotnet restore generated_csharp/Tests/ChronicleKnights.Tests.csproj",
  "remoteUser": "root"
}
