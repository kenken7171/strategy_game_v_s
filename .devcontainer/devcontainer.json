{
  "name": "Chronicle Knights (.NET 8 + Godot 4.3 mono)",
  "workspaceFolder": "/workspaces/strategy_game_v_s/generated_csharp",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "DOTNET_SDK_TAG": "8.0",
      "GODOT_VERSION": "4.3",
      "GODOT_RELEASE": "stable"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": { "label": "Godot Desktop (noVNC web)" },
    "5901": { "label": "Godot Desktop (VNC)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "geequlim.godot-tools"
      ],
      "settings": {
        "dotnet.defaultSolution": "ChronicleKnights.sln",
        "godotTools.editorPath.godot4": "/usr/local/bin/godot"
      }
    }
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "postCreateCommand": "dotnet build ChronicleKnights.csproj --configuration Debug",
  "remoteUser": "root"
}
